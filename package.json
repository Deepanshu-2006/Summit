{
  "name": "summit-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "pnpm --filter @summit/web dev",
    "dev:all": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @summit/web dev",
    "dev:backend": "pnpm --filter @summit/backend dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck"
  }
}
