{
  "name": "summit-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@summit/web",
    "dev:backend": "turbo run dev --filter=@summit/backend",
    "build": "turbo run build",
    "build:backend": "turbo run build --filter=@summit/backend",
    "lint": "turbo run lint",
    "lint:backend": "turbo run lint --filter=@summit/backend",
    "typecheck": "turbo run typecheck",
    "typecheck:web": "turbo run typecheck --filter=@summit/web",
    "typecheck:api": "turbo run typecheck --filter=@summit/api-spec",
    "test": "turbo run test",
    "test:backend": "turbo run test --filter=@summit/backend"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
