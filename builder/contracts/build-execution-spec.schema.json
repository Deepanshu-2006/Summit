{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://summit.dev/schemas/builder/build-execution-spec.schema.json",
  "title": "BuildExecutionSpec",
  "description": "Execution specification for a single isolated build attempt",
  "type": "object",
  "required": [
    "schema_version",
    "build",
    "source",
    "build_config",
    "credentials",
    "output",
    "resources",
    "timeout_seconds",
    "reporting"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Version of the execution specification schema"
    },
    "build": {
      "type": "object",
      "required": ["id", "attempt_id", "attempt_number"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Authoritative UUID of the build",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "attempt_id": {
          "type": "string",
          "description": "Authoritative UUID of this execution attempt",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "attempt_number": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based ordinal of this execution attempt"
        },
        "correlation_id": {
          "type": "string",
          "description": "Optional tracing or request correlation identifier"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "provider",
        "repository",
        "clone_url",
        "commit_sha",
        "root_directory"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["github", "gitlab", "bitbucket", "generic"],
          "description": "Source code repository provider"
        },
        "repository": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$",
          "description": "Repository identifier (e.g. organization/repository)"
        },
        "clone_url": {
          "type": "string",
          "format": "uri",
          "description": "Authenticated or public git clone URL"
        },
        "branch": {
          "type": "string",
          "description": "Target branch name"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$",
          "description": "Pinned git commit SHA (40 hex chars for SHA-1, 64 hex chars for SHA-256)"
        },
        "root_directory": {
          "type": "string",
          "default": "/",
          "description": "Relative root directory within the repository where application source resides"
        }
      }
    },
    "build_config": {
      "type": "object",
      "required": ["builder"],
      "additionalProperties": false,
      "properties": {
        "builder": {
          "type": "string",
          "enum": ["railpack", "dockerfile", "auto"],
          "description": "Strategy or engine used to construct the image"
        },
        "build_command": {
          "type": ["string", "null"],
          "description": "Optional custom compilation/build command"
        },
        "install_command": {
          "type": ["string", "null"],
          "description": "Optional custom dependency installation command"
        },
        "start_command": {
          "type": ["string", "null"],
          "description": "Optional runtime entrypoint command"
        },
        "dockerfile_path": {
          "type": ["string", "null"],
          "description": "Relative path to Dockerfile if builder strategy is dockerfile"
        },
        "env_vars": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Build-time environment variables"
        }
      }
    },
    "credentials": {
      "type": "object",
      "required": ["source_credential_ref", "registry_credential_ref"],
      "additionalProperties": false,
      "properties": {
        "source_credential_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque reference token to resolve short-lived source git credentials"
        },
        "registry_credential_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque reference token to resolve registry push credentials"
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["registry", "repository", "tag", "platforms"],
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1,
          "description": "Target OCI container registry hostname"
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "Target repository path on registry"
        },
        "tag": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,127}$",
          "description": "Target image tag"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Target architectures/platforms (e.g. linux/amd64)"
        }
      }
    },
    "resources": {
      "type": "object",
      "required": ["cpu_millicores", "memory_mib", "ephemeral_storage_mib"],
      "additionalProperties": false,
      "properties": {
        "cpu_millicores": {
          "type": "integer",
          "minimum": 100,
          "description": "CPU ceiling in millicores"
        },
        "memory_mib": {
          "type": "integer",
          "minimum": 128,
          "description": "Memory ceiling in MiB"
        },
        "ephemeral_storage_mib": {
          "type": "integer",
          "minimum": 512,
          "description": "Ephemeral storage ceiling in MiB"
        }
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 86400,
      "description": "Hard execution timeout in seconds"
    },
    "reporting": {
      "type": "object",
      "required": ["endpoint", "token_ref"],
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string",
          "format": "uri",
          "description": "HTTP endpoint of the control plane reporter service"
        },
        "token_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Authentication token reference for reporting status and logs"
        }
      }
    }
  }
}
