{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://summit.dev/schemas/builder/build-execution-result.schema.json",
  "title": "BuildExecutionResult",
  "description": "Structured execution result reported upon build completion, failure, or cancellation",
  "type": "object",
  "required": [
    "schema_version",
    "build_id",
    "attempt_id",
    "status",
    "metadata",
    "timestamps"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Version of the execution result schema"
    },
    "build_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "description": "Authoritative UUID of the build"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "description": "Authoritative UUID of this execution attempt"
    },
    "status": {
      "type": "string",
      "enum": ["succeeded", "failed", "cancelled"],
      "description": "Terminal status of the build execution"
    },
    "artifact": {
      "type": "object",
      "description": "Artifact details present upon successful completion",
      "required": ["repository", "digest", "tag", "platforms"],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "Full repository path including registry"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$",
          "description": "Cryptographic OCI manifest or image index digest"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "description": "Tag assigned to the image"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Architectures built"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Total image size in bytes if available"
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "builder",
        "railpack_version",
        "buildkit_version",
        "commit_sha"
      ],
      "additionalProperties": false,
      "properties": {
        "builder": {
          "type": "string",
          "description": "Builder engine used"
        },
        "railpack_version": {
          "type": "string",
          "description": "Version of Railpack used"
        },
        "buildkit_version": {
          "type": "string",
          "description": "Version of BuildKit daemon used"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$",
          "description": "Pinned commit SHA verified during checkout"
        },
        "detected_runtime": {
          "type": "string",
          "description": "Application runtime detected (e.g. nodejs, go, python)"
        }
      }
    },
    "error": {
      "type": "object",
      "description": "Structured error details populated on failed or cancelled status",
      "required": ["code", "stage", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "description": "Stable uppercase machine-readable error code"
        },
        "stage": {
          "type": "string",
          "description": "Execution stage during which failure occurred"
        },
        "message": {
          "type": "string",
          "description": "Human-readable error explanation (sanitized of secrets)"
        },
        "details": {
          "type": "string",
          "description": "Optional extended error output or context"
        }
      }
    },
    "timestamps": {
      "type": "object",
      "required": ["started_at", "completed_at", "duration_ms"],
      "additionalProperties": false,
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time",
          "description": "RFC3339 timestamp when execution began"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time",
          "description": "RFC3339 timestamp when execution concluded"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Total execution duration in milliseconds"
        }
      }
    }
  }
}
